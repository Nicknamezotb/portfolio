---
import Base from '../layouts/Base.astro';
import { content, url, cover, single, ytThumb, cropStyle } from '../lib/media';

const { settings, home, galleries, videos, creations, projects } = content;
const hero = single(home.heroPhoto) ?? cover([], 'hero');
const side = home.heroSide === 'right' ? 'right' : 'left';
const opacity = Math.min(100, Math.max(0, home.heroOpacity ?? 55));
const [first, ...rest] = settings.name.trim().split(/\s+/);

const firstVideo = videos.flatMap((c) => c.items)[0];
const videoCount = videos.reduce((n, c) => n + c.items.length, 0);
const featured = projects.find((p) => p.slug === home.featured) ?? projects[0];
const featuredImg: { src?: string; thumb: string } | null | undefined =
  featured && (single(featured.cover) ?? (featured.youtube ? { thumb: ytThumb(featured.youtube) } : cover([], featured.slug)));

// Images des cartes : celle choisie dans l'admin, sinon une image par défaut tirée du contenu
const worksBg = single(home.worksBg ?? null);
const cards = home.cards ?? { photo: null, video: null, creations: null };
const entries = [
  {
    href: '/photo', title: 'Photo', meta: `${galleries.length} galeries`,
    pic: single(cards.photo) ?? cover(galleries[0]?.photos, galleries[0]?.slug ?? 'photo'),
  },
  {
    href: '/video', title: 'Vidéo', meta: `${videoCount} projets`,
    pic: single(cards.video) ?? (firstVideo ? { src: ytThumb(firstVideo.youtube) } : null),
  },
  {
    href: '/creations', title: 'Créations', meta: `${creations.length} identités visuelles`,
    pic: single(cards.creations) ?? cover(creations[0]?.sections.flatMap((s) => s.photos), creations[0]?.slug ?? 'creations'),
  },
];
---
<Base bodyClass="home">
  <section class:list={['hero', `side-${side}`, { bare: !hero }]} style={`--veil:${opacity}%`}>
    {hero && <img data-hero-bg class="hero-bg" src={hero.src} style={cropStyle(hero)} alt="" fetchpriority="high" width={hero.w} height={hero.h} />}
    <div class="veil" aria-hidden="true"></div>

    <div class="hero-inner wrap" data-hero-fade>
      <div class="hero-text">
        <p class="mono kicker">{settings.role}</p>
        <h1 class="display">
          <span class="w">{first}</span>
          {rest.length > 0 && <span class="w">{rest.join(' ')}</span>}
        </h1>
        <p class="tagline">{home.tagline}</p>
        <div class="ctas">
          <a href={url('/photo')} class="link-arrow">Photos <span>→</span></a>
          <a href={url('/video')} class="link-arrow">Vidéos <span>→</span></a>
        </div>
      </div>
    </div>

    {home.heroCaption && <p class="mono caption">{home.heroCaption}</p>}
    <a href="#travaux" class="scroll" aria-label="Défiler"><span></span></a>
  </section>

  <section id="travaux" class:list={["works", { "has-bg": worksBg }]}>
    {worksBg && <div class="works-bgwrap" aria-hidden="true"><img class="works-bg" data-par="0.05" src={worksBg.src} style={cropStyle(worksBg)} alt="" loading="lazy" /></div>}
    <div class="wrap works-inner">
    <header class="works-head">
      <h2 class="display reveal" style="--i:1">Travaux</h2>
    </header>

    <!-- Composition décalée : chaque carte défile à sa propre vitesse (data-par) -->
    <div class="works-grid">
      {entries.map((e, i) => (
        <a href={url(e.href)} class={`work work-${i + 1}`} data-par={[0.02, -0.025, 0.035][i]} data-fade>
          <div class="work-media">
            <div class="zw">{e.pic && <img data-zoom src={e.pic.src} style={cropStyle(e.pic as any)} alt="" loading="lazy" />}</div>
            <div class="work-cap">
              <span class="mono">{e.meta}</span>
              <h3 class="display">{e.title}</h3>
              <span class="mono more">Découvrir <span>→</span></span>
            </div>
          </div>
        </a>
      ))}
    </div>
    </div>
  </section>

  {featured && (
    <section class="featured">
      <a href={url(`/projets/${featured.slug}`)} class="feat" data-fade>
        {featuredImg && <img data-zoom data-par="0.04" class="feat-img" src={featuredImg.src ?? featuredImg.thumb} style={cropStyle(featuredImg as any)} alt="" loading="lazy" />}
        <div class="feat-veil" aria-hidden="true"></div>
        <div class="feat-text">
          <p class="mono">À la une{featured.kicker && ` · ${featured.kicker}`}</p>
          <h3 class="display">{featured.title}</h3>
          <p class="feat-intro">{featured.intro.split(/\n\s*\n/)[0]}</p>
          <span class="link-arrow">Voir le projet <span>→</span></span>
        </div>
        {(featured.place || featured.date) && <p class="mono feat-meta">{[featured.place, featured.date].filter(Boolean).join(' · ')}</p>}
      </a>
    </section>
  )}
</Base>

<script>
  // Animations liées au défilement, lissées (chaque valeur « glisse » vers sa cible au lieu de sauter) :
  //  - hero : le texte s'estompe, monte et se floute ; la photo descend plus lentement (profondeur)
  //  - [data-par]  : l'élément défile à sa propre vitesse (composition qui « respire »)
  //  - [data-zoom] : l'image dézoome doucement en arrivant au centre de l'écran
  //  - [data-fade] : fondu d'entrée par le bas, léger estompage en sortant par le haut
  const still = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const heroText = document.querySelector<HTMLElement>('[data-hero-fade]');
  const heroBg = document.querySelector<HTMLElement>('[data-hero-bg]');
  const pars = [...document.querySelectorAll<HTMLElement>('[data-par]')];
  const zooms = [...document.querySelectorAll<HTMLElement>('[data-zoom]')];
  const fades = [...document.querySelectorAll<HTMLElement>('[data-fade]')];

  const clamp = (v: number, a = 0, b = 1) => Math.min(b, Math.max(a, v));
  const smooth = (t: number) => t * t * (3 - 2 * t);
  const state = new Map<HTMLElement, Record<string, number>>();
  const lerp = (el: HTMLElement, key: string, target: number, k = 0.12) => {
    const s = state.get(el) ?? (state.set(el, {}), state.get(el)!);
    const cur = s[key] ?? target;
    const next = cur + (target - cur) * k;
    s[key] = Math.abs(next - target) < 0.0005 ? target : next;
    return { v: s[key], moving: s[key] !== target };
  };

  if (still) {
    fades.forEach((el) => (el.style.opacity = '1'));
  } else {
    let running = false;
    const frame = () => {
      let moving = false;
      const vh = innerHeight;
      const mobile = innerWidth < 720;

      if (heroText) {
        // Sans lissage : le hero suit exactement le défilement, donc plus aucun mouvement
        // résiduel une fois revenu tout en haut (et rien ne bouge pendant le rebond du navigateur).
        const p = clamp(Math.max(0, scrollY) / (vh * 0.7));
        heroText.style.opacity = String(1 - p);
        heroText.style.transform = p ? `translate3d(0, ${p * -40}px, 0)` : '';
        heroText.style.filter = p > 0.01 ? `blur(${p * 4}px)` : '';
        if (heroBg) heroBg.style.transform = p ? `translate3d(0, ${p * vh * 0.1}px, 0)` : '';
      }

      for (const el of fades) {
        const r = el.getBoundingClientRect();
        // 0 quand le haut de l'élément touche le bas de l'écran, 1 quand il est monté de 35 % de l'écran
        const enter = smooth(clamp((vh - r.top) / (vh * 0.35)));
        // estompage léger quand l'élément quitte l'écran par le haut
        const leave = 1 - 0.55 * smooth(clamp(-r.bottom / (vh * 0.4) + 1.6));
        const o = lerp(el, 'o', enter * leave, 0.1);
        moving ||= o.moving;
        el.style.opacity = o.v.toFixed(3);
        el.style.setProperty('--enter', o.v.toFixed(3));
      }

      for (const el of pars) {
        const r = el.getBoundingClientRect();
        const center = r.top + r.height / 2 - vh / 2;
        const speed = parseFloat(el.dataset.par || '0') * (mobile ? 0.4 : 1);
        const y = lerp(el, 'y', -center * speed, 0.1);
        moving ||= y.moving;
        el.style.transform = `translate3d(0, ${y.v.toFixed(2)}px, 0)`;
      }

      for (const img of zooms) {
        const r = (img.closest('.work-media, .feat') ?? img).getBoundingClientRect();
        const t = clamp(1 - Math.abs(r.top + r.height / 2 - vh / 2) / vh);
        const s = lerp(img, 's', 1, 0.1);
        moving ||= s.moving;
        // l'image de « À la une » a aussi une parallaxe : on combine les deux
        const y = img.dataset.par ? (state.get(img)?.y ?? 0) : 0;
        img.style.transform = `translate3d(0, ${y.toFixed(2)}px, 0) scale(${s.v.toFixed(4)})`;
      }

      running = moving;
      if (moving) requestAnimationFrame(frame);
    };
    const kick = () => { if (!running) { running = true; requestAnimationFrame(frame); } };
    addEventListener('scroll', kick, { passive: true });
    addEventListener('resize', kick);
    // premier rendu : on part de l'état « invisible » pour que les cartes glissent en place
    fades.forEach((el) => state.set(el, { o: 0 }));
    kick();
  }
</script>

<style>
  /* ---------- Hero plein écran, texte incrusté sur un voile ---------- */
  .hero {
    position: relative; height: 100svh; min-height: 620px; overflow: hidden;
    display: flex; align-items: flex-end;
  }
  .hero-bg {
    will-change: transform;
    position: absolute; left: 0; top: -6%; width: 100%; height: 112%; object-fit: cover; /* dépasse en haut et en bas : le décalage ne découvre jamais le fond */
    animation: settle 2.8s var(--ease) both;
  }
  @keyframes settle { from { opacity: 0; } }

  /* Voile : verre dépoli teinté de la couleur du fond, qui s'efface vers la photo */
  .veil {
    position: absolute; inset: 0; width: min(780px, 62%);
    background: linear-gradient(to right,
      color-mix(in srgb, var(--bg) var(--veil), transparent) 0%,
      color-mix(in srgb, var(--bg) calc(var(--veil) * .85), transparent) 55%,
      transparent 100%);
    backdrop-filter: blur(16px) saturate(1.1);
    -webkit-backdrop-filter: blur(16px) saturate(1.1);
    mask-image: linear-gradient(to right, #000 50%, transparent 100%);
    -webkit-mask-image: linear-gradient(to right, #000 50%, transparent 100%);
    animation: veilIn 1.6s .3s var(--ease) both;
  }
  @keyframes veilIn { from { opacity: 0; transform: translateX(-40px); } }
  .side-right .veil { left: auto; right: 0; transform-origin: right; }
  .side-right .veil {
    background: linear-gradient(to left,
      color-mix(in srgb, var(--bg) var(--veil), transparent) 0%,
      color-mix(in srgb, var(--bg) calc(var(--veil) * .85), transparent) 55%,
      transparent 100%);
    mask-image: linear-gradient(to left, #000 50%, transparent 100%);
    -webkit-mask-image: linear-gradient(to left, #000 50%, transparent 100%);
    animation-name: veilInR;
  }
  @keyframes veilInR { from { opacity: 0; transform: translateX(40px); } }


  .hero-inner { will-change: opacity, transform; position: relative; z-index: 2; display: flex; padding-bottom: clamp(48px, 10vh, 112px); }
  .side-right .hero-inner { justify-content: flex-end; }
  .hero-text { max-width: 460px; }
  .side-right .hero-text { text-align: right; }

  .kicker { display: flex; align-items: center; margin: 0 0 22px; color: var(--text); text-shadow: var(--soft-shadow); }
  .side-right .kicker { justify-content: flex-end; }
  .hero h1 { font-size: clamp(64px, 8.5vw, 132px); line-height: .86; text-shadow: var(--soft-shadow); }
  .hero h1 .w { display: block; animation: rise 1.2s var(--ease) both; }
  .hero h1 .w:nth-child(2) { animation-delay: .12s; }
  @keyframes rise { from { opacity: 0; transform: translateY(28px); } }
  .tagline { text-shadow: var(--soft-shadow); margin: 26px 0 30px; font-size: 16px; line-height: 1.65; max-width: 36ch; animation: rise 1.2s .25s var(--ease) both; }
  .side-right .tagline { margin-left: auto; }
  .ctas { display: flex; gap: 28px; animation: rise 1.2s .35s var(--ease) both; }
  .side-right .ctas { justify-content: flex-end; }

  .caption {
    position: absolute; z-index: 2; bottom: clamp(24px, 4vh, 40px); right: var(--gutter); margin: 0;
    color: #fff; text-shadow: 0 1px 8px rgb(0 0 0 / .45);
  }
  .side-right .caption { right: auto; left: var(--gutter); }

  .scroll {
    position: absolute; z-index: 2; left: 50%; bottom: 0; width: 1px; height: 56px; overflow: hidden;
    background: color-mix(in srgb, var(--text) 18%, transparent);
  }
  .scroll span { position: absolute; inset: 0; background: var(--text); animation: drip 2.2s var(--ease) infinite; }
  @keyframes drip { from { transform: translateY(-100%); } to { transform: translateY(100%); } }

  /* Sans photo : hero typographique simple */
  .hero.bare { height: 80svh; }
  .hero.bare .veil, .hero.bare .scroll { display: none; }

  /* ---------- Travaux : trois cartes compactes, légèrement décalées, sur une photo de fond estompée ---------- */
  .works { position: relative; overflow: hidden; padding-block: clamp(96px, 16vh, 170px) clamp(72px, 12vh, 130px); }
  /* Cadre de la taille de la section : le fondu y est appliqué, donc les bords sont toujours transparents */
  .works-bgwrap {
    position: absolute; inset: 0; z-index: 0; overflow: hidden; pointer-events: none;
    mask-image: linear-gradient(to bottom, transparent 0%, #000 30%, #000 70%, transparent 100%);
    -webkit-mask-image: linear-gradient(to bottom, transparent 0%, #000 30%, #000 70%, transparent 100%);
  }
  .works-bg {
    position: absolute; z-index: 0; left: -6%; top: -12%; width: 112%; height: 124%; max-width: none; object-fit: cover;
    filter: blur(30px) saturate(1.2); opacity: .45; will-change: transform;
  }
  .works-inner { position: relative; z-index: 2; }
  .works-head { display: flex; align-items: baseline; justify-content: space-between; gap: 16px; margin-bottom: clamp(32px, 6vh, 64px); }
  .works-head .mono { margin: 0; order: 2; }
  .works-head h2 { font-size: clamp(40px, 5vw, 72px); }

  .works-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: clamp(14px, 2vw, 28px); max-width: 1120px; }
  .work { position: relative; display: block; opacity: 0; will-change: transform, opacity; }
  .work-2 { margin-top: clamp(28px, 6vh, 64px); }
  .work-3 { margin-top: clamp(10px, 2vh, 24px); }
  .work-media { aspect-ratio: 4 / 5; }

  .work-media {
    position: relative; overflow: hidden; border-radius: 6px; background: var(--raised);
    box-shadow: 0 24px 48px -28px rgb(0 0 0 / .4), 0 1px 3px rgb(0 0 0 / .05);
    transition: opacity .9s var(--ease-out), filter .9s var(--ease-out), box-shadow .9s var(--ease-out), transform .9s var(--ease-out);
  }
  .zw { position: absolute; inset: 0; transition: transform 1.4s var(--ease-out); }
  .zw img { width: 100%; height: 100%; object-fit: cover; will-change: transform; }
  .work-media::after {
    content: ''; position: absolute; inset: 0; pointer-events: none;
    background: linear-gradient(to top, rgb(10 11 14 / .55) 0%, rgb(10 11 14 / .12) 40%, transparent 65%);
    opacity: .9; transition: opacity .9s var(--ease-out);
  }
  .work-cap {
    position: absolute; z-index: 1; left: 18px; right: 18px; bottom: 16px;
    color: #fff; display: grid; gap: 4px;
    transform: translateY(calc((1 - var(--enter, 1)) * 14px));
  }
  .work-cap .mono { color: rgb(255 255 255 / .8); font-size: 10px; }
  .work-cap h3 { font-size: clamp(28px, 2.6vw, 38px); text-shadow: 0 2px 18px rgb(0 0 0 / .25); }
  .more { display: inline-flex; gap: 6px; opacity: 0; transform: translateY(6px); transition: opacity .6s var(--ease-out), transform .6s var(--ease-out); font-size: 10px; }

  /* Survol : seule la carte visée réagit (elle se soulève, l'ombre s'étire, le texte monte) */
  .work:hover .work-media { transform: translateY(-8px); box-shadow: 0 40px 70px -30px rgb(0 0 0 / .5), 0 2px 6px rgb(0 0 0 / .06); }
  .work-cap h3 { transition: transform .8s var(--ease-out); }
  .work:hover .work-cap h3 { transform: translateY(-4px); }
    .work:hover .work-media::after { opacity: 1; }
  .work:hover .more { opacity: 1; transform: none; }

  /* ---------- À la une : grand panneau avec le même voile que le hero ---------- */
  .featured { padding-block: clamp(40px, 8vh, 100px) 0; }
  .feat {
    position: relative; display: block; overflow: hidden; opacity: 0;
    width: calc(100% - 2 * var(--gutter)); max-width: 1560px; margin-inline: auto;
    height: min(62svh, 580px); min-height: 420px; border-radius: 6px; max-width: 1320px;
  }
  .feat-img { position: absolute; inset: -4% 0; width: 100%; height: 108%; object-fit: cover; will-change: transform; }
  .feat-veil {
    position: absolute; inset: 0; width: min(760px, 64%);
    background: linear-gradient(to right, color-mix(in srgb, var(--bg) 78%, transparent), color-mix(in srgb, var(--bg) 55%, transparent) 55%, transparent);
    backdrop-filter: blur(14px); -webkit-backdrop-filter: blur(14px);
    mask-image: linear-gradient(to right, #000 50%, transparent); -webkit-mask-image: linear-gradient(to right, #000 50%, transparent);
  }
  .feat-text {
    position: absolute; left: clamp(24px, 5vw, 80px); bottom: clamp(28px, 7vh, 80px); max-width: 440px;
    transform: translateY(calc((1 - var(--enter, 1)) * 40px));
  }
  .feat-text .mono { margin: 0 0 16px; color: var(--text); }
  .feat-text h3 { font-size: clamp(36px, 4vw, 60px); line-height: .9; text-shadow: var(--soft-shadow); }
  .feat-intro { font-size: 14px; margin: 14px 0 22px; color: color-mix(in srgb, var(--text) 80%, transparent); text-shadow: var(--soft-shadow); }
  .feat-meta { position: absolute; right: clamp(20px, 3vw, 40px); bottom: clamp(20px, 3vw, 36px); margin: 0; color: #fff; text-shadow: 0 1px 8px rgb(0 0 0 / .45); }
  .feat .link-arrow { transition: color .4s, border-color .4s; }
  .feat:hover .link-arrow { color: var(--accent); border-color: var(--accent); }

  @media (max-width: 860px) {
    .works-grid { grid-template-columns: 1fr 1fr; }
    .work-3 { grid-column: span 2; margin-top: 0; }
    .work-3 .work-media { aspect-ratio: 16 / 9; }
    .work-2 { margin-top: 32px; }
    .more { opacity: 1; transform: none; }
  }}
  @media (max-width: 640px) {
    /* Sur mobile, le voile remonte depuis le bas */
    .hero { height: 92svh; min-height: 560px; }
    .veil, .side-right .veil {
      inset: auto 0 0; width: 100%; height: 72%;
      background: linear-gradient(to top,
        color-mix(in srgb, var(--bg) var(--veil), transparent) 0%,
        color-mix(in srgb, var(--bg) calc(var(--veil) * .8), transparent) 50%,
        transparent 100%);
      mask-image: linear-gradient(to top, #000 45%, transparent 100%);
      -webkit-mask-image: linear-gradient(to top, #000 45%, transparent 100%);
      animation-name: veilUp;
    }
    @keyframes veilUp { from { opacity: 0; transform: translateY(40px); } }
    .side-right .hero-inner { justify-content: flex-start; }
    .side-right .hero-text, .side-right .kicker, .side-right .ctas { text-align: left; justify-content: flex-start; }
    .side-right .tagline { margin-left: 0; }
    .caption, .side-right .caption { top: 84px; bottom: auto; right: var(--gutter); left: auto; }
    .scroll { display: none; }
  }
  @media (max-width: 640px) {
    .feat { height: 82svh; }
    .feat-veil {
      inset: auto 0 0; width: 100%; height: 75%;
      background: linear-gradient(to top, color-mix(in srgb, var(--bg) 82%, transparent), color-mix(in srgb, var(--bg) 55%, transparent) 55%, transparent);
      mask-image: linear-gradient(to top, #000 50%, transparent); -webkit-mask-image: linear-gradient(to top, #000 50%, transparent);
    }
    .feat-text { right: 24px; }
    .feat-meta { top: 20px; bottom: auto; }
  }
  @media (prefers-reduced-motion: reduce) {
    .work, .feat { opacity: 1; }
  }
</style>

---
import Base from '../layouts/Base.astro';
import { content, url, cover, single, ytThumb } from '../lib/media';

const { settings, home, galleries, videos, creations, projects } = content;
const hero = single(home.heroPhoto) ?? cover([], 'hero');
const firstVideo = videos.flatMap((c) => c.items)[0];
const videoCount = videos.reduce((n, c) => n + c.items.length, 0);
const featured = projects.find((p) => p.slug === home.featured) ?? projects[0];
const featuredImg = featured && (single(featured.cover) ?? (featured.youtube ? { thumb: ytThumb(featured.youtube) } : cover([], featured.slug)));

const entries = [
  { href: '/photo', title: 'Photo', meta: `${galleries.length} galeries`, img: cover(galleries[0]?.photos, galleries[0]?.slug ?? 'photo')?.thumb },
  { href: '/video', title: 'Vidéo', meta: `${videoCount} projets`, img: firstVideo ? ytThumb(firstVideo.youtube) : undefined },
  { href: '/creations', title: 'Créations', meta: `${creations.length} identités visuelles`, img: cover(creations[0]?.sections[0]?.photos, creations[0]?.slug ?? 'creations')?.thumb },
];
---
<Base>
  <section class="wrap hero">
    <p class="mono">{settings.role}</p>
    <div class="hero-row">
      <h1 class="display">{settings.name}</h1>
      <p class="lede">{home.tagline}</p>
    </div>
  </section>

  {hero && (
    <div class="wrap">
      <div class="hero-img img-frame">
        <img src={hero.src} alt="" fetchpriority="high" width={hero.w} height={hero.h} />
      </div>
    </div>
  )}

  <section class="wrap section">
    <div class="section-title">
      <h2 class="display">Travaux</h2>
    </div>
    <div class="entries">
      {entries.map((e) => (
        <a href={url(e.href)} class="entry reveal">
          <div class="img-frame">{e.img && <img src={e.img} alt="" loading="lazy" />}</div>
          <div class="entry-meta">
            <h3 class="display">{e.title}</h3>
            <span class="mono">{e.meta}</span>
          </div>
        </a>
      ))}
    </div>
  </section>

  {featured && (
    <section class="wrap section reveal">
      <div class="section-title">
        <h2 class="display">À la une</h2>
        <span class="mono">{[featured.place, featured.date].filter(Boolean).join(' · ')}</span>
      </div>
      <a href={url(`/projets/${featured.slug}`)} class="feature">
        <div class="img-frame feature-img">{featuredImg && <img src={featuredImg.thumb} alt="" loading="lazy" />}</div>
        <div class="feature-text">
          {featured.kicker && <p class="mono">{featured.kicker}</p>}
          <h3 class="display">{featured.title}</h3>
          <p>{featured.intro.split(/\n\s*\n/)[0]}</p>
          <span class="link-arrow">Voir le projet <span>→</span></span>
        </div>
      </a>
    </section>
  )}
</Base>

<style>
  .hero { padding-top: clamp(120px, 20vh, 200px); padding-bottom: clamp(28px, 5vh, 48px); }
  .hero > .mono { margin: 0 0 14px; }
  .hero-row { display: flex; align-items: flex-end; justify-content: space-between; gap: 32px; flex-wrap: wrap; }
  .hero h1 { font-size: clamp(56px, 9vw, 128px); animation: rise 1.2s var(--ease) both; }
  .hero .lede { margin: 0; max-width: 40ch; animation: rise 1.2s .15s var(--ease) both; }
  @keyframes rise { from { opacity: 0; transform: translateY(18px); } }

  .hero-img { aspect-ratio: 21 / 9; animation: fade 1.6s .2s var(--ease) both; }
  @keyframes fade { from { opacity: 0; } }

  .entries { display: grid; grid-template-columns: repeat(3, 1fr); gap: clamp(12px, 2vw, 28px); }
  .entry .img-frame { aspect-ratio: 4 / 5; }
  .entry:hover img { transform: scale(1.04); }
  .entry-meta { display: flex; justify-content: space-between; align-items: baseline; gap: 12px; padding-top: 14px; }
  .entry h3 { font-size: clamp(28px, 2.8vw, 38px); transition: color .3s; }
  .entry:hover h3 { color: var(--accent); }

  .feature { display: grid; grid-template-columns: 1.5fr 1fr; gap: clamp(24px, 4vw, 56px); align-items: end; }
  .feature-img { aspect-ratio: 16 / 9; }
  .feature:hover .feature-img img { transform: scale(1.03); }
  .feature-text .mono { margin: 0 0 10px; }
  .feature-text h3 { font-size: clamp(32px, 3.4vw, 48px); margin-bottom: 14px; }
  .feature-text p:not(.mono) { color: var(--muted); margin: 0 0 24px; }

  @media (max-width: 860px) {
    .entries { grid-template-columns: 1fr 1fr; }
    .entries .entry:last-child { grid-column: span 2; }
    .entries .entry:last-child .img-frame { aspect-ratio: 16 / 9; }
    .feature { grid-template-columns: 1fr; }
    .hero-img { aspect-ratio: 4 / 3; }
  }
  @media (max-width: 520px) {
    .entries { grid-template-columns: 1fr; }
    .entries .entry:last-child { grid-column: auto; }
    .entry .img-frame, .entries .entry:last-child .img-frame { aspect-ratio: 3 / 2; }
  }
</style>

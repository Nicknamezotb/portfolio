---
import Base from '../../layouts/Base.astro';
import creations from '../../data/creations.json';
import { url, getPhotos } from '../../lib/media';
---
<Base title="Créations visuelles" description="Identités visuelles réalisées par Quentin Girard pour la vie associative de l'ISEP.">
  <div class="wrap">
    <header class="page-head">
      <span class="mono">Vie associative · ISEP</span>
      <h1 class="display">Créations</h1>
    </header>

    <ul class="rows">
      {creations.map((c) => {
        const cover = getPhotos(c.sections[0].media, 1)[0];
        return (
          <li class="reveal">
            <a href={url(`/creations/${c.slug}`)}>
              <div class="thumb">
                {cover.placeholder ? <div class="ph" /> : <img src={cover.thumb} alt="" loading="lazy" />}
              </div>
              <div class="txt">
                <h2 class="display">{c.title}</h2>
                <p class="mono">{c.org} · {c.year}</p>
              </div>
              <p class="work">{c.work.join(', ')}</p>
              <span class="arrow" aria-hidden="true">→</span>
            </a>
          </li>
        );
      })}
    </ul>
  </div>
</Base>

<style>
  .rows { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--line); }
  .rows a {
    display: grid; grid-template-columns: 160px 1fr 1fr auto; align-items: center; gap: clamp(16px, 3vw, 48px);
    padding: clamp(20px, 3vw, 32px) 0; border-bottom: 1px solid var(--line);
  }
  .thumb { aspect-ratio: 4/3; overflow: hidden; background: var(--bg-raised); }
  .thumb img, .ph { width: 100%; height: 100%; object-fit: cover; transition: transform 1.2s var(--ease); }
  .ph { background: linear-gradient(135deg, rgb(110 159 193 / .08), transparent 65%), var(--bg-raised); }
  .rows a:hover .thumb img, .rows a:hover .ph { transform: scale(1.06); }
  h2 { font-size: clamp(44px, 6vw, 88px); transition: color .3s; }
  .txt .mono { margin: 6px 0 0; }
  .work { color: var(--muted); margin: 0; }
  .arrow { font-size: 26px; color: var(--dim); transition: color .3s, transform .4s var(--ease); }
  .rows a:hover h2, .rows a:hover .arrow { color: var(--accent); }
  .rows a:hover .arrow { transform: translateX(6px); }
  @media (max-width: 860px) {
    .rows a { grid-template-columns: 96px 1fr auto; }
    .work { display: none; }
  }
</style>

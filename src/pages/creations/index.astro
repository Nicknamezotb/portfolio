---
import Base from '../../layouts/Base.astro';
import Tile from '../../components/Tile.astro';
import Backdrop from '../../components/Backdrop.astro';
import { content, url, cover, single } from '../../lib/media';
const { creations } = content;
const bg = single(content.pageBgs?.creations ?? null);
---
<Base title="Créations visuelles" description="Identités visuelles réalisées pour la vie associative de l'ISEP.">
  <Backdrop photo={bg} />
  <div class="wrap">
    <header class="page-head">
      <span class="mono">Identités visuelles · {creations.length}</span>
      <h1 class="display">Créations</h1>
    </header>

    <div class="cards">
      {creations.map((c, i) => (
        <Tile
          href={url(`/creations/${c.slug}`)}
          img={cover(c.sections.flatMap((s) => s.photos), c.slug)}
          title={c.title}
          meta={[c.org, c.year].filter(Boolean).join(' · ')}
          sub={c.work}
          aspect="4 / 5"
          i={i}
        />
      ))}
    </div>
  </div>
</Base>

<style>
  .cards { display: grid; grid-template-columns: repeat(3, 1fr); gap: clamp(16px, 2.4vw, 32px); }
  @media (max-width: 900px) { .cards { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 560px) { .cards { grid-template-columns: 1fr; } }
</style>

---
import Base from '../layouts/Base.astro';
import PhotoGrid from '../components/PhotoGrid.astro';
import VideoEmbed from '../components/VideoEmbed.astro';
import mp from '../data/machu-picchu.json';
import { url, getPhotos } from '../lib/media';
---
<Base title={mp.title} description="Projet Machu Picchu : documentaire et photos d'un voyage de 26 jours au Pérou, juillet 2025.">
  <div class="wrap">
    <header class="page-head">
      <span class="mono">Documentaire · {mp.place} · {mp.date}</span>
      <h1 class="display">Machu<br />Picchu</h1>
    </header>

    <div class="intro">
      {mp.intro.map((p) => <p class="lede">{p}</p>)}
    </div>

    <section class="section">
      <div class="section-title"><h2 class="display">Documentaire</h2></div>
      <VideoEmbed id={mp.youtube} title={mp.title} />
    </section>

    {mp.sections.map((s) => (
      <section class="section">
        <div class="section-title">
          <h2 class="display">{s.title}</h2>
          {s.caption && <span class="mono">{s.caption}</span>}
        </div>
        <PhotoGrid photos={getPhotos(s.media, s.placeholderCount)} label={`${mp.place} · 2025`} />
      </section>
    ))}

    <a href={url('/photo/perou')} class="link-arrow">Plus de photos du Pérou <span>→</span></a>
  </div>
</Base>

<style>
  .intro { max-width: 680px; margin-left: auto; }
  .intro .lede { margin: 0 0 1.2em; }
</style>

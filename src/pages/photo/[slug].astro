---
import Base from '../../layouts/Base.astro';
import PhotoGrid from '../../components/PhotoGrid.astro';
import { content, url, photos } from '../../lib/media';

export function getStaticPaths() {
  const { galleries } = content;
  return galleries.map((g, i) => ({
    params: { slug: g.slug },
    props: { g, next: galleries[(i + 1) % galleries.length] },
  }));
}
const { g, next } = Astro.props;
const list = photos(g.photos, g.slug, 15);
const label = [g.place, g.year].filter(Boolean).join(' · ');
---
<Base title={g.title} description={`${g.title}${g.context ? ` (${g.context})` : ''} — galerie photo, ${g.year}.`}>
  <div class="wrap">
    <header class="page-head">
      <a href={url('/photo')} class="mono back">← Galeries</a>
      <h1 class="display">{g.title}</h1>
      <p class="mono info">
        {g.context && <span>{g.context}</span>}
        {label && <span>{label}</span>}
        <span>{list.length} photos</span>
      </p>
    </header>

    <PhotoGrid photos={list} label={g.title} />

    <nav class="after">
      {g.related && <a href={url(g.related)} class="link-arrow">Voir le projet lié <span>→</span></a>}
      {next.slug !== g.slug && (
        <a href={url(`/photo/${next.slug}`)} class="next">
          <span class="mono">Galerie suivante</span>
          <span class="display">{next.title} →</span>
        </a>
      )}
    </nav>
  </div>
</Base>

<style>
  .info { display: flex; flex-wrap: wrap; gap: 6px 24px; margin: 18px 0 0; }
  .after { display: flex; justify-content: space-between; align-items: flex-end; gap: 24px; flex-wrap: wrap; margin-top: clamp(48px, 8vh, 96px); }
  .next { margin-left: auto; text-align: right; display: flex; flex-direction: column; gap: 6px; }
  .next .display { font-size: clamp(32px, 4vw, 52px); transition: color .3s; }
  .next:hover .display { color: var(--accent); }
</style>

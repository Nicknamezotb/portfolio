---
import Base from '../../layouts/Base.astro';
import { content, url, cover } from '../../lib/media';
const { galleries } = content;
---
<Base title="Photo" description="Galeries photo : événements, concerts, conférences et voyages.">
  <div class="wrap">
    <header class="page-head">
      <span class="mono">Galeries · {galleries.length}</span>
      <h1 class="display">Photo</h1>
    </header>

    <div class="cards">
      {galleries.map((g) => {
        const c = cover(g.photos, g.slug);
        return (
          <a href={url(`/photo/${g.slug}`)} class="card reveal">
            <div class="img-frame">{c && <img src={c.thumb} alt="" loading="lazy" />}</div>
            <div class="meta">
              <h2 class="display">{g.title}</h2>
              <span class="mono">{[g.place, g.year].filter(Boolean).join(' · ')}</span>
            </div>
          </a>
        );
      })}
    </div>
  </div>
</Base>

<style>
  .cards { display: grid; grid-template-columns: repeat(3, 1fr); gap: clamp(28px, 4vw, 48px) clamp(12px, 2vw, 24px); }
  .img-frame { aspect-ratio: 4 / 3; }
  .card:hover img { transform: scale(1.04); }
  .meta { display: flex; justify-content: space-between; align-items: baseline; gap: 12px; padding-top: 12px; }
  .meta h2 { font-size: clamp(24px, 2.2vw, 30px); transition: color .3s; }
  .card:hover h2 { color: var(--accent); }
  @media (max-width: 900px) { .cards { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 560px) { .cards { grid-template-columns: 1fr; } }
</style>

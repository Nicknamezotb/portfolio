---
import Base from '../../layouts/Base.astro';
import galleries from '../../data/galleries.json';
import { url, getPhotos } from '../../lib/media';
---
<Base title="Photo" description="Galeries photo de Quentin Girard : événements, concerts, conférences et voyages.">
  <div class="wrap">
    <header class="page-head">
      <span class="mono">Galeries · {galleries.length}</span>
      <h1 class="display">Photo</h1>
    </header>

    <div class="cards">
      {galleries.map((g) => {
        const cover = getPhotos(g.slug, 1)[0];
        const count = getPhotos(g.slug, g.placeholderCount).length;
        return (
          <a href={url(`/photo/${g.slug}`)} class="card reveal">
            <div class="cover">
              {cover.placeholder
                ? <div class="ph" />
                : <img src={cover.thumb} alt="" loading="lazy" width={cover.w} height={cover.h} />}
            </div>
            <div class="meta">
              <h2 class="display">{g.title}</h2>
              <span class="mono">{g.place} · {g.year} · {count} photos</span>
            </div>
          </a>
        );
      })}
    </div>
  </div>
</Base>

<style>
  .cards { display: grid; grid-template-columns: repeat(2, 1fr); gap: clamp(32px, 5vw, 72px) clamp(16px, 3vw, 40px); }
  .cover { aspect-ratio: 3/2; overflow: hidden; background: var(--bg-raised); }
  .cover img, .ph { width: 100%; height: 100%; object-fit: cover; transition: transform 1.4s var(--ease), opacity .6s; }
  .ph { background: linear-gradient(135deg, rgb(110 159 193 / .08), transparent 65%), var(--bg-raised); }
  .card:hover .cover img, .card:hover .ph { transform: scale(1.035); }
  .meta { display: flex; justify-content: space-between; align-items: baseline; gap: 16px; padding-top: 16px; }
  .meta h2 { font-size: clamp(32px, 3.4vw, 48px); transition: color .3s; }
  .card:hover h2 { color: var(--accent); }
  .meta .mono { text-align: right; }
  @media (max-width: 720px) {
    .cards { grid-template-columns: 1fr; }
    .meta { flex-direction: column; gap: 4px; }
    .meta .mono { text-align: left; }
  }
</style>

---
import Base from '../layouts/Base.astro';
import { content } from '../lib/media';
const { settings } = content;
const action = settings.formspreeId ? `https://formspree.io/f/${settings.formspreeId}` : '';
---
<Base title="Contact" description={`Contacter ${settings.name}, ${settings.role.toLowerCase()}.`}>
  <div class="wrap">
    <header class="page-head">
      <span class="mono">Contact</span>
      <h1 class="display">Parlons-en</h1>
    </header>

    <div class="layout">
      <aside>
        <p class="lede">Un tournage, un événement à couvrir, une identité visuelle ? Écris-moi, je réponds rapidement.</p>
        <a href={`mailto:${settings.email}`} class="email">{settings.email}</a>
        <ul>
          {settings.socials.map((s) => <li><a href={s.url} target="_blank" rel="noopener" class="link-arrow">{s.label} <span>↗</span></a></li>)}
        </ul>
      </aside>

      <form id="contact" action={action} method="POST" data-email={settings.email}>
        <label><span class="mono">Nom</span><input name="name" autocomplete="name" required /></label>
        <label><span class="mono">E-mail</span><input name="email" type="email" autocomplete="email" required /></label>
        <label><span class="mono">Message</span><textarea name="message" rows="6" required></textarea></label>
        <input type="text" name="_gotcha" tabindex="-1" autocomplete="off" class="hp" aria-hidden="true" />
        <button type="submit" class="send">Envoyer <span aria-hidden="true">→</span></button>
        <p class="status" role="status" aria-live="polite"></p>
      </form>
    </div>
  </div>
</Base>

<style>
  .layout { display: grid; grid-template-columns: 1fr 1.2fr; gap: clamp(40px, 7vw, 112px); }
  .lede { margin-top: 0; }
  .email { display: inline-block; font-size: clamp(17px, 1.6vw, 21px); margin: 12px 0 28px; border-bottom: 1px solid var(--line); transition: color .3s, border-color .3s; }
  .email:hover { color: var(--accent); border-color: var(--accent); }
  ul { list-style: none; padding: 0; margin: 0; display: flex; flex-wrap: wrap; gap: 20px; }
  form { display: grid; gap: 24px; }
  label { display: grid; gap: 8px; }
  input, textarea {
    font: inherit; color: var(--text); background: transparent; border: 0; border-bottom: 1px solid var(--line);
    padding: 6px 0 10px; border-radius: 0; resize: vertical; transition: border-color .3s;
  }
  input:focus, textarea:focus { outline: none; border-color: var(--accent); }
  .hp { position: absolute; left: -9999px; }
  .send {
    justify-self: start; background: var(--text); color: var(--bg); border: 0; cursor: pointer;
    font-family: var(--font-mono); font-size: 12px; letter-spacing: .1em; text-transform: uppercase;
    padding: 14px 24px; transition: background .3s;
  }
  .send:hover { background: var(--accent); }
  .send:disabled { opacity: .5; cursor: wait; }
  .status { margin: 0; min-height: 1.5em; font-size: 14px; color: var(--muted); }
  @media (max-width: 860px) { .layout { grid-template-columns: 1fr; } }
</style>

<script>
  const form = document.getElementById('contact') as HTMLFormElement;
  const status = form.querySelector('.status')!;
  const btn = form.querySelector('button')!;
  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    const data = new FormData(form);
    // Pas de Formspree configuré : on ouvre la messagerie avec le message prérempli.
    if (!form.getAttribute('action')) {
      const subject = encodeURIComponent(`Contact portfolio : ${data.get('name')}`);
      const body = encodeURIComponent(`${data.get('message')}\n\n${data.get('name')} (${data.get('email')})`);
      location.href = `mailto:${form.dataset.email}?subject=${subject}&body=${body}`;
      return;
    }
    btn.disabled = true;
    status.textContent = 'Envoi…';
    try {
      const res = await fetch(form.action, { method: 'POST', body: data, headers: { Accept: 'application/json' } });
      if (!res.ok) throw new Error();
      form.reset();
      status.textContent = 'Merci, ton message est bien parti. Je te réponds vite.';
    } catch {
      status.textContent = `L'envoi a échoué. Écris-moi directement à ${form.dataset.email}.`;
    } finally {
      btn.disabled = false;
    }
  });
</script>

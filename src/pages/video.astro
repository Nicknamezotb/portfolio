---
import Base from '../layouts/Base.astro';
import VideoEmbed from '../components/VideoEmbed.astro';
import { content, url } from '../lib/media';

const { videos } = content;
const total = videos.reduce((n, c) => n + c.items.length, 0);
---
<Base title="Vidéo" description="Projets vidéo : aftermovies, interviews, documentaires de voyage et clips.">
  <div class="wrap">
    <header class="page-head">
      <span class="mono">Projets · {total}</span>
      <h1 class="display">Vidéo</h1>
    </header>

    {videos.filter((c) => c.items.length).map((cat) => (
      <section class="cat">
        <div class="section-title">
          <h2 class="display">{cat.category}</h2>
          <span class="mono">{cat.items.length}</span>
        </div>
        <div class="list">
          {cat.items.map((v) => (
            <article class="item reveal">
              <VideoEmbed id={v.youtube} title={v.title} />
              <div class="caption">
                <h3>{v.title}</h3>
                {v.subtitle && <p class="sub">{v.subtitle}</p>}
                {(v.credit || v.year) && <p class="mono">{[v.credit, v.year].filter(Boolean).join(' · ')}</p>}
                {v.link && <a href={url(v.link)} class="link-arrow">Voir le projet <span>→</span></a>}
              </div>
            </article>
          ))}
        </div>
      </section>
    ))}
  </div>
</Base>

<style>
  .cat { margin-bottom: clamp(56px, 10vh, 112px); }
  .list { display: grid; grid-template-columns: repeat(2, 1fr); gap: clamp(36px, 5vw, 64px) clamp(14px, 2.4vw, 32px); }
  .caption { padding-top: 14px; }
  h3 { font-size: 16px; font-weight: 550; line-height: 1.4; margin: 0 0 4px; }
  .sub { color: var(--muted); margin: 0 0 8px; font-size: 14px; }
  .caption .mono { margin: 0; }
  .link-arrow { margin-top: 14px; }
  @media (max-width: 760px) { .list { grid-template-columns: 1fr; } }
</style>

---
import Base from '../../layouts/Base.astro';
import Backdrop from '../../components/Backdrop.astro';
import PhotoGrid from '../../components/PhotoGrid.astro';
import VideoEmbed from '../../components/VideoEmbed.astro';
import { content, url, photos, cover, rich, cropStyle } from '../../lib/media';

export function getStaticPaths() {
  return content.projects.map((p) => ({ params: { slug: p.slug }, props: { p } }));
}
const { p } = Astro.props;
const paragraphs = p.intro.split(/\n\s*\n/).filter(Boolean);
const meta = [p.kicker, p.place, p.date].filter(Boolean).join(' · ');
const backdrop = p.cover ? cover([p.cover], p.slug) : cover(p.sections.flatMap((s) => s.photos), p.slug);
---
<Base title={p.title} description={paragraphs[0]?.replace(/\*\*/g, '').slice(0, 160)}>
  <Backdrop photo={backdrop} />
  <div class="wrap">
    <!-- En-tête : grande photo de couverture, titre incrusté (même esprit que « À la une ») -->
    <header class:list={['banner', { 'no-img': !backdrop }]}>
      {backdrop && <img class="banner-img" src={backdrop.src ?? backdrop.thumb} style={cropStyle(backdrop)} alt="" fetchpriority="high" />}
      <div class="banner-veil" aria-hidden="true"></div>
      <div class="banner-text">
        {meta && <span class="mono">{meta}</span>}
        <h1 class="display">{p.title}</h1>
      </div>
    </header>

    <!-- Texte et vidéo côte à côte : pas de grand vide à gauche du texte -->
    <div class:list={['intro', { 'has-video': p.youtube }]}>
      <div class="text">
        {paragraphs.map((t) => <p set:html={rich(t)} />)}
      </div>

      {p.youtube && (
        <article class="film reveal">
          <div class="frame"><VideoEmbed id={p.youtube} title={p.title} /></div>
          <div class="caption">
            <h3>{p.kicker || 'Vidéo'}</h3>
            {(p.place || p.date) && <p class="mono">{[p.place, p.date].filter(Boolean).join(' · ')}</p>}
          </div>
        </article>
      )}
    </div>

    {p.sections.map((s, i) => (
      <section class="block">
        <div class="block-head">
          <h2 class="display">{s.title}</h2>
          {s.caption && <span class="mono">{s.caption}</span>}
        </div>
        <PhotoGrid photos={photos(s.photos, `${p.slug}-${i}`, 10)} label={`${p.title}, ${s.title}`} columns={5} />
      </section>
    ))}

    {p.moreLink && <a href={url(p.moreLink)} class="link-arrow more">{p.moreLabel || 'En voir plus'} <span>→</span></a>}
  </div>
</Base>

<style>
  /* ---------- En-tête ---------- */
  .banner {
    position: relative; overflow: hidden; border-radius: 8px; margin-top: 88px;
    height: clamp(320px, 52vh, 560px); background: var(--raised);
    box-shadow: 0 30px 60px -36px rgb(0 0 0 / .45);
  }
  .banner.no-img { height: auto; background: none; box-shadow: none; }
  .banner-img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; animation: bnIn 1.4s var(--ease-out) both; }
  @keyframes bnIn { from { opacity: 0; } }
  .banner-veil { position: absolute; inset: 0; background: linear-gradient(to top, rgb(10 11 14 / .62) 0%, rgb(10 11 14 / .18) 45%, transparent 70%); }
  .no-img .banner-veil { display: none; }
  .banner-text { position: absolute; left: clamp(20px, 3.5vw, 48px); right: 20px; bottom: clamp(20px, 3.5vw, 44px); color: #fff; display: grid; gap: 12px; justify-items: start; }
  .no-img .banner-text { position: static; color: var(--text); padding-top: 24px; }
  .banner-text .mono { color: rgb(255 255 255 / .85); margin: 0; }
  .no-img .banner-text .mono { color: var(--muted); }
  .banner-text h1 { font-size: clamp(44px, 6.5vw, 96px); margin: 0 0 0 -0.045em; line-height: .9; text-shadow: 0 2px 24px rgb(0 0 0 / .25); }

  .intro { margin-top: clamp(32px, 5vh, 56px); display: grid; gap: clamp(28px, 4vw, 56px); align-items: start; }
  .intro.has-video { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); }
  .text p { margin: 0 0 1em; font-size: clamp(15px, 1.15vw, 17px); line-height: 1.75; color: color-mix(in srgb, var(--text) 82%, var(--bg)); max-width: 58ch; }
  .text p:last-child { margin-bottom: 0; }
  .text :global(strong) { color: var(--text); font-weight: 650; }

  /* Même carte vidéo que sur la page Vidéo : cliquable, coins arrondis, se soulève au survol */
  .frame {
    border-radius: 6px; overflow: hidden; background: #1c1d22;
    box-shadow: 0 24px 48px -28px rgb(0 0 0 / .4), 0 1px 3px rgb(0 0 0 / .05);
    transition: box-shadow .9s var(--ease-out), transform .9s var(--ease-out);
  }
  .film:hover .frame { transform: translateY(-6px); box-shadow: 0 40px 70px -30px rgb(0 0 0 / .5), 0 2px 6px rgb(0 0 0 / .06); }
  .caption { padding-top: 14px; }
  .caption h3 { font-size: 16px; font-weight: 550; line-height: 1.4; margin: 0 0 4px; transition: color .4s; }
  .film:hover h3 { color: var(--accent); }
  .caption .mono { margin: 0; }

  /* Sections de photos plus compactes */
  .block { margin-top: clamp(40px, 6vh, 64px); }
  .block-head { display: flex; align-items: baseline; gap: 14px; flex-wrap: wrap; margin-bottom: 16px; }
  .block-head h2 { font-size: clamp(26px, 2.6vw, 34px); }
  .more { margin-top: clamp(28px, 4vh, 44px); }

  @media (max-width: 860px) {
    .intro.has-video { grid-template-columns: 1fr; }
    .banner { margin-top: 76px; height: 46vh; }
  }
</style>

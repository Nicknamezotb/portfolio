---
import type { Photo } from '../lib/media';
interface Props { photos: Photo[]; label?: string; columns?: number }
const { photos, label = '', columns = 3 } = Astro.props;
---
{photos.length > 0 && (
  <div class="grid" style={`--cols:${columns}`} data-lightbox>
    {photos.map((p, i) => (
      <a class="tile" href={p.src} data-index={i}>
        <img src={p.thumb} alt={p.alt || `${label}, photo ${i + 1}`} width={p.w} height={p.h} loading="lazy" decoding="async" />
      </a>
    ))}
  </div>
)}

<style>
  .grid { columns: var(--cols); column-gap: clamp(8px, 1vw, 14px); }
  .tile { display: block; break-inside: avoid; margin-bottom: clamp(8px, 1vw, 14px); background: var(--raised); overflow: hidden; cursor: zoom-in; border-radius: 4px; }
  .tile img { width: 100%; transition: opacity .6s var(--ease-out); }
  .grid:hover .tile img { opacity: .82; }
  .grid .tile:hover img { opacity: 1; }
  @media (max-width: 960px) { .grid { columns: 2; } }
  @media (max-width: 480px) { .grid { column-gap: 6px; } .tile { margin-bottom: 6px; } }
</style>

<script>
  import { initLightbox } from '../lib/lightbox';
  document.querySelectorAll<HTMLElement>('[data-lightbox]').forEach(initLightbox);
</script>

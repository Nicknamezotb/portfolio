---
import { content, url } from '../lib/media';
const { settings } = content;
---
<footer class="footer">
  <div class="wrap">
    <div class="cta">
      <p class="mono">Un projet, une collaboration ?</p>
      <a href={url('/contact')} class="display big">Parlons-en <span aria-hidden="true">→</span></a>
    </div>
    <div class="bottom">
      <span class="mono">© {new Date().getFullYear()} {settings.name}</span>
      <ul>
        {settings.socials.map((s) => <li><a class="mono" href={s.url} target="_blank" rel="noopener">{s.label}</a></li>)}
        <li><a class="mono" href={`mailto:${settings.email}`}>E-mail</a></li>
      </ul>
    </div>
  </div>
</footer>

<style>
  .footer { border-top: 1px solid var(--line); margin-top: clamp(56px, 10vh, 112px); }
  .cta { padding-block: clamp(48px, 8vh, 88px); }
  .cta .mono { margin: 0 0 12px; }
  .big { font-size: clamp(44px, 6vw, 80px); display: inline-block; transition: color .3s; }
  .big span { display: inline-block; transition: transform .4s var(--ease); }
  .big:hover { color: var(--accent); }
  .big:hover span { transform: translateX(10px); }
  .bottom { display: flex; flex-wrap: wrap; gap: 16px; justify-content: space-between; padding: 20px 0 28px; border-top: 1px solid var(--line); }
  ul { list-style: none; display: flex; flex-wrap: wrap; gap: 20px; margin: 0; padding: 0; }
  ul a:hover { color: var(--text); }
</style>

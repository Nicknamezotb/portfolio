---
import { content, url } from '../lib/media';
const { settings } = content;
// Pas d'encart « Travaillons ensemble » sur la page Contact elle-même
const onContact = Astro.url.pathname.replace(/\/+$/, '').endsWith('/contact');
---
<footer class="footer">
  <div class="wrap">
    <!-- Encart de contact : panneau arrondi et doux, sans trait de séparation -->
    {!onContact && (
    <div class="contact-card reveal">
      <div class="cc-text">
        <p class="mono">Un projet, une collaboration ?</p>
        <h2 class="display">Travaillons ensemble</h2>
      </div>
      <div class="cc-actions">
        <a href={url('/contact')} class="pill solid">Me contacter</a>
      </div>
    </div>
    )}

    <div class="bottom">
      <span class="mono">© {new Date().getFullYear()} {settings.name}</span>
      <ul>
        {settings.socials.map((s) => <li><a class="mono" href={s.url} target="_blank" rel="noopener">{s.label}</a></li>)}
      </ul>
    </div>
  </div>
</footer>

<style>
  .footer { margin-top: clamp(64px, 12vh, 140px); padding-bottom: 8px; }

  .contact-card {
    display: flex; align-items: center; justify-content: space-between; gap: 28px; flex-wrap: wrap;
    padding: clamp(28px, 4vw, 48px) clamp(24px, 4vw, 56px);
    border-radius: 18px;
    background: color-mix(in srgb, var(--text) 4%, var(--bg));
    box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--text) 6%, transparent);
  }
  .cc-text .mono { margin: 0 0 10px; }
  .cc-text h2 { font-size: clamp(32px, 3.6vw, 52px); }

  .cc-actions { display: flex; flex-wrap: wrap; gap: 10px; }
  .pill {
    font-family: inherit; color: inherit; background: none; border: 0; cursor: pointer;
    display: inline-flex; align-items: center; height: 46px; padding: 0 22px; border-radius: 999px;
    font-size: 14px; font-weight: 500; white-space: nowrap;
    box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--text) 16%, transparent);
    transition: background .4s var(--ease-out), color .4s var(--ease-out), box-shadow .4s var(--ease-out), transform .4s var(--ease-out);
  }
  .pill:hover { box-shadow: inset 0 0 0 1px var(--text); transform: translateY(-2px); }
  .pill.solid { background: var(--text); color: var(--bg); box-shadow: none; }
  .pill.solid:hover { background: var(--accent); }

  .bottom { display: flex; flex-wrap: wrap; gap: 14px 24px; justify-content: space-between; align-items: center; padding: 28px 4px 24px; }
  ul { list-style: none; display: flex; flex-wrap: wrap; gap: 22px; margin: 0; padding: 0; }
  ul a { transition: color .3s; }
  ul a:hover { color: var(--text); }

  @media (max-width: 640px) {
    .cc-actions { width: 100%; }
    .pill { flex: 1 1 auto; justify-content: center; }
    .bottom { flex-direction: column-reverse; align-items: flex-start; }
  }
</style>


---
import { content, url } from '../lib/media';
const links = [
  { href: '/photo', label: 'Photo' },
  { href: '/video', label: 'Vidéo' },
  { href: '/creations', label: 'Créations' },
  { href: '/contact', label: 'Contact' },
];
const path = Astro.url.pathname.replace(import.meta.env.BASE_URL.replace(/\/$/, ''), '') || '/';
const isActive = (href: string) => path === href || path.startsWith(href + '/');
---
<header class="nav">
  <div class="wrap nav-inner">
    <a href={url('/')} class="brand display" aria-label="Accueil">{content.settings.name}</a>
    <button class="burger" aria-expanded="false" aria-controls="menu" aria-label="Menu">
      <span></span><span></span>
    </button>
    <nav id="menu" aria-label="Navigation principale">
      {links.map((l) => (
        <a href={url(l.href)} class:list={{ active: isActive(l.href) }} aria-current={isActive(l.href) ? 'page' : undefined}>{l.label}</a>
      ))}
    </nav>
  </div>
</header>

<style>
  /* --nav (0 → 1) est piloté en continu par le défilement (script plus bas) : la barre apparaît
     progressivement au lieu de basculer d'un coup. */
  .nav {
    --n: var(--nav, 1);
    position: fixed; inset: 0 0 auto; z-index: 50;
    background: color-mix(in srgb, var(--bg) calc(var(--n) * 84%), transparent);
    backdrop-filter: blur(calc(var(--n) * 18px)) saturate(calc(1 + var(--n) * .15));
    -webkit-backdrop-filter: blur(calc(var(--n) * 18px)) saturate(calc(1 + var(--n) * .15));
    border-bottom: 1px solid color-mix(in srgb, var(--line) calc(var(--n) * 100%), transparent);
  }
  .nav-inner { display: flex; align-items: center; justify-content: space-between; height: 68px; } /* hauteur fixe : rien ne bouge pendant le défilement */
  .brand { font-size: 24px; letter-spacing: .04em; position: relative; z-index: 2; }
  /* Accueil : le nom est déjà en grand sur la photo, il apparaît dans le menu au fil du défilement */
  :global(body.home:not(.menu-open)) .brand {
    opacity: var(--n);
    transform: translateY(calc((1 - var(--n)) * -8px));
    filter: blur(calc((1 - var(--n)) * 4px));
  }
  :global(body.home:not(.scrolled):not(.menu-open)) .brand { pointer-events: none; }

  nav { display: flex; gap: clamp(22px, 3vw, 40px); }
  nav a {
    font-family: var(--font-mono); font-size: 14px; letter-spacing: .12em; text-transform: uppercase;
    color: var(--muted); position: relative; padding: 8px 0;
    transition: color .4s var(--ease), text-shadow .6s var(--ease);
  }
  nav a::after {
    content: ''; position: absolute; left: 0; right: 0; bottom: 2px; height: 1px; background: var(--accent);
    transform: scaleX(0); transform-origin: left; transition: transform .5s var(--ease);
  }
  nav a:hover, nav a.active { color: var(--text); }
  nav a:hover::after, nav a.active::after { transform: scaleX(1); }

  /* Accueil, en haut de page : liens posés sur la photo, avec la même ombre douce que le grand nom */
  @media (min-width: 721px) {
    nav { padding: 6px 4px; }
    :global(body.home:not(.scrolled)) nav a { color: var(--text); text-shadow: var(--soft-shadow); }
  }
  .burger { display: none; background: none; border: 0; width: 40px; height: 40px; cursor: pointer; position: relative; margin-right: -8px; }
  .burger span { position: absolute; left: 9px; right: 9px; height: 1.5px; background: var(--text); transition: transform .35s var(--ease); }
  .burger span:first-child { top: 16px; } .burger span:last-child { top: 23px; }

  @media (max-width: 720px) {
    /* en haut de l'accueil sur mobile : léger dégradé pour garder le nom et le menu lisibles */
    :global(body.home:not(.menu-open)) .nav {
      background:
        linear-gradient(to bottom, color-mix(in srgb, var(--bg) calc((1 - var(--n)) * 75%), transparent), transparent),
        color-mix(in srgb, var(--bg) calc(var(--n) * 84%), transparent);
    }
    .burger { display: block; z-index: 2; }
    nav {
      position: fixed; inset: 0; flex-direction: column; justify-content: center; align-items: flex-start;
      padding: 0 var(--gutter); gap: 4px; background: var(--bg);
      opacity: 0; visibility: hidden; transition: opacity .35s, visibility .35s;
    }
    nav a { font-family: var(--font-display); font-size: 44px; letter-spacing: .02em; text-transform: none; color: var(--text); }
    nav a.active { color: var(--accent); } nav a.active::after { display: none; }
    :global(body.menu-open) nav { opacity: 1; visibility: visible; }
    :global(body.menu-open) .burger span:first-child { transform: translateY(3.5px) rotate(45deg); }
    :global(body.menu-open) .burger span:last-child { transform: translateY(-3.5px) rotate(-45deg); }
    :global(body.menu-open) { overflow: hidden; }
  }
</style>

<script>
  const burger = document.querySelector<HTMLButtonElement>('.burger')!;
  burger.addEventListener('click', () => {
    const open = document.body.classList.toggle('menu-open');
    burger.setAttribute('aria-expanded', String(open));
  });
  // --nav suit directement le défilement (sans retard) : 0 en haut, 1 quand la barre est pleinement affichée.
  // Sur l'accueil, la transition se fait pendant que le grand nom s'efface (entre 8 % et 38 % de l'écran).
  const home = document.body.classList.contains('home');
  const root = document.documentElement;
  let ticking = false;
  const update = () => {
    const y = Math.max(0, scrollY);
    const t = home ? (y - innerHeight * 0.08) / (innerHeight * 0.3) : y / 40;
    const n = Math.min(1, Math.max(0, t));
    root.style.setProperty('--nav', n.toFixed(3));
    document.body.classList.toggle('scrolled', n > 0.5);
    ticking = false;
  };
  addEventListener('scroll', () => { if (!ticking) { ticking = true; requestAnimationFrame(update); } }, { passive: true });
  addEventListener('resize', update);
  update();
</script>

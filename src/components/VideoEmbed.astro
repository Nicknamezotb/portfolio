---
// Façade YouTube : n'affiche que la miniature, l'iframe ne se charge qu'au clic.
interface Props { id: string; title: string }
const { id, title } = Astro.props;
---
<div class="video" data-yt={id} data-title={title}>
  <img
    src={`https://i.ytimg.com/vi/${id}/maxresdefault.jpg`}
    data-fallback={`https://i.ytimg.com/vi/${id}/hqdefault.jpg`}
    alt="" loading="lazy" decoding="async" width="1280" height="720"
  />
  <button type="button" aria-label={`Lire la vidéo : ${title}`}>
    <span class="disc" aria-hidden="true">
      <svg viewBox="0 0 24 24"><path d="M9 6.8v10.4a.8.8 0 0 0 1.22.68l8.2-5.2a.8.8 0 0 0 0-1.36l-8.2-5.2A.8.8 0 0 0 9 6.8Z" fill="currentColor"/></svg>
    </span>
  </button>
</div>

<style>
  .video { position: relative; aspect-ratio: 16 / 9; background: #1c1d22; overflow: hidden; cursor: pointer; }
  .video img { width: 100%; height: 100%; object-fit: cover; }
  /* Léger voile pour que le bouton ressorte sur n'importe quelle miniature ; il s'éclaircit au survol */
  .video::after {
    content: ''; position: absolute; inset: 0; pointer-events: none;
    background: radial-gradient(circle at center, rgb(10 11 14 / .28), rgb(10 11 14 / .08) 55%, transparent 80%);
    transition: opacity .6s var(--ease-out);
  }
  .video:hover::after { opacity: .5; }
  .video button {
    position: absolute; inset: 0; z-index: 1; width: 100%; height: 100%; padding: 0; border: 0; background: none;
    display: grid; place-items: center; cursor: pointer;
  }
  /* Disque blanc net, ombre douce, triangle aux coins arrondis optiquement centré */
  .disc {
    width: 58px; height: 58px; border-radius: 50%; display: grid; place-items: center;
    background: rgb(255 255 255 / .94); color: #15161a;
    box-shadow: 0 10px 30px -6px rgb(0 0 0 / .45), 0 0 0 1px rgb(255 255 255 / .35);
    transition: background .4s var(--ease-out), color .4s var(--ease-out), box-shadow .5s var(--ease-out), transform .5s var(--ease-out);
  }
  .disc svg { width: 22px; height: 22px; margin-left: 3px; }
  .video:hover .disc { background: var(--accent); color: #fff; box-shadow: 0 14px 36px -6px rgb(0 0 0 / .5), 0 0 0 6px rgb(255 255 255 / .18); }
  .video button:focus-visible { outline: none; }
  .video button:focus-visible .disc { box-shadow: 0 0 0 3px var(--accent), 0 10px 30px -6px rgb(0 0 0 / .45); }
  .video :global(iframe) { position: absolute; inset: 0; z-index: 2; width: 100%; height: 100%; border: 0; }
  @media (max-width: 560px) { .disc { width: 50px; height: 50px; } .disc svg { width: 19px; height: 19px; } }
</style>

<script>
  document.querySelectorAll<HTMLElement>('.video[data-yt]').forEach((el) => {
    const img = el.querySelector('img')!;
    // maxresdefault n'existe pas pour toutes les vidéos (YouTube renvoie alors une image de 120 px)
    const check = () => { if (img.naturalWidth && img.naturalWidth < 200) img.src = img.dataset.fallback!; };
    if (img.complete) check(); else img.addEventListener('load', check, { once: true });
    img.addEventListener('error', () => (img.src = img.dataset.fallback!), { once: true });

    el.addEventListener('click', () => {
      const f = document.createElement('iframe');
      f.src = `https://www.youtube-nocookie.com/embed/${el.dataset.yt}?autoplay=1&rel=0`;
      f.title = el.dataset.title || 'Vidéo';
      f.allow = 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; fullscreen';
      f.allowFullscreen = true;
      el.replaceChildren(f);
      el.style.cursor = 'default';
    }, { once: true });
  });
</script>
